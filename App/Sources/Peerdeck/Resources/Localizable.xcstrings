    "%@ can’t reach their tracker right now. They show up here if it lasts more than %lld h.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %@现在连不上 tracker，持续超过 %lld 小时才会出现在这里。"
          }
        }
      }
    },
    "%@ couldn’t be deleted and are back in the list.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %@ 没删掉，已经放回列表。"
          }
        }
      }
    },
    "%@ doesn’t report tracker status (qBittorrent 5.1.x), so its %@ aren’t listed here. Upgrade to 5.2 or later.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不提供 tracker 状态（qBittorrent 5.1.x），它的 %@不在这里。升级到 5.2 以上就能用。"
          }
        }
      }
    },
    "%@ free": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩 %@"
          }
        }
      }
    },
    "%@ is now recorded as an old domain of %@, so the site view and stats stay together.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已记为 %@ 的旧域名，站点视图和统计不会被拆开。"
          }
        }
      }
    },
    "%@ left": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩 %@"
          }
        }
