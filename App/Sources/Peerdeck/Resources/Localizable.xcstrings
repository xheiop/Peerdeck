    "Working": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正常"
          }
        }
      }
    },
    "Works with qBittorrent, Transmission and Flood. Each client can have several routes: LAN at home; DDNS, an overlay network or a reverse proxy when away. Passwords are stored in the Keychain.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 qBittorrent、Transmission 和 Flood。一台下载器可以配多条线路：在家走内网，在外走 DDNS、组网或反代。密码保存在钥匙串里。"
          }
        }
      }
    },
    "Wrong username or password": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户名或密码错误"
          }
        }
