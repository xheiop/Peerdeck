    "%@: tracker status isn’t reliable here, so %@ aren’t listed. Behind Flood, connect to the client directly; qBittorrent 5.1.x needs 5.2 or later.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 拿不到可靠的 tracker 状态，它的 %2$@不会列在这里。接在 Flood 后面的请直连下载器；qBittorrent 5.1.x 要升级到 5.2 以上。"
          }
        }
      }
    },
