    "%lld of them are cross-seeded: after moving files, the other torrents won’t find the data.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "1 of them is cross-seeded: after moving files, the other torrents won’t find the data."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld of them are cross-seeded: after moving files, the other torrents won’t find the data."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中 %lld 个是辅种：移动文件后，其他种子会找不到数据。"
          }
        }
      }
    },
    "%lld of them are cross-seeded; their files will always be kept.": {
